# ATHENA CRYPTO - DEMO (Delta India testnet / demo account)
#
# Demo accounts are a SEPARATE environment from production:
#   URL    : https://testnet.delta.exchange     (create the demo account here)
#   REST   : https://cdn-ind.testnet.deltaex.org
#   WS     : wss://socket-ind-pub.testnet.deltaex.org (public)
#            wss://socket-ind.testnet.deltaex.org     (private)
# Production keys DO NOT work here - generate keys INSIDE the demo account.
#
# Put this file at athena_crypto/.env.demo (chmod 600) and run with:
#   python -m athena_crypto.cli --env .env.demo run --live

DELTA_ENV=india_test
DELTA_API_KEY=your_demo_api_key_here
DELTA_API_SECRET=your_demo_api_secret_here
DELTA_FORCE_IPV4=1

# Trade the demo account as if it held Rs 200,000 (= 200000 / fx).
# Remove this line to size off the full demo wallet balance instead.
ATHENA_EQUITY=2272.73
