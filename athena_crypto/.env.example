# ATHENA CRYPTO - Delta Exchange credentials
# Copy to .env (or rely on the workspace root .env) and fill in.
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Venue override. Valid: india_prod (default) | india_test | global_prod | global_test
DELTA_ENV=india_prod

# Optional runtime overrides
ATHENA_EQUITY=1000.0
ATHENA_LOG_LEVEL=INFO